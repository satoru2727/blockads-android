    <string name="https_wizard_troubleshooting_title">Suggerimenti per la risoluzione dei problemi</string>
    <string name="https_wizard_troubleshooting_tip1">Assicurati di aver selezionato \"Certificato CA\" in Impostazioni (non Certificato utente o Certificato VPN e app).</string>
