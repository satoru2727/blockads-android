    <string name="https_wizard_step_indicator_format">Étape %1$d sur %2$d : %3$s</string>
    <string name="https_wizard_security_title">Sécurité et confidentialité</string>
    <string name="https_wizard_security_desc">Le certificat CA racine est généré localement sur votre appareil et ne quitte jamais votre téléphone. BlockAds l\'utilise strictement pour supprimer les publicités sur les sites Web. Les services sensibles tels que les applications bancaires et les comptes Google ne sont jamais interceptés.</string>
    <string name="https_wizard_explain_title">Pourquoi le filtrage HTTPS ?</string>
    <string name="https_wizard_explain_desc">La plupart des sites Web et des publicités utilisent des connexions HTTPS chiffrées. Pour masquer les espaces réservés aux publicités, les bannières et les pop-ups, BlockAds nécessite un certificat local pour inspecter et filtrer les pages Web en toute sécurité sur votre appareil.</string>
    <string name="https_wizard_benefits_title">Principaux avantages</string>
    <string name="https_wizard_benefit_1">Suppression des publicités sur les plateformes vidéo et les sites d\'actualités</string>
    <string name="https_wizard_benefit_2">Masquage des espaces réservés vides, des bannières et des pop-ups intrusifs</string>
    <string name="https_wizard_benefit_3">Exécution de scriptlets pour déjouer les mécanismes anti-bloqueurs de publicités</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% sur l\'appareil</string>
    <string name="https_wizard_privacy_on_device_desc">Les clés et le certificat sont générés localement sur votre téléphone et ne sont jamais transmis.</string>
    <string name="https_wizard_privacy_bypass_title">Contourne les applications bancaires et financières</string>
    <string name="https_wizard_privacy_bypass_desc">Les domaines sensibles (banques, identification, Google) sont directement transférés et jamais déchiffrés.</string>
    <string name="https_wizard_privacy_browser_title">Périmètre de navigateur contrôlé</string>
    <string name="https_wizard_privacy_browser_desc">Vous contrôlez totalement les navigateurs qui utilisent le filtrage HTTPS et pouvez le désactiver à tout moment.</string>
