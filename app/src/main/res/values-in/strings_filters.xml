    <string name="https_wizard_title">Pengaturan Sertifikat</string>
    <string name="https_wizard_step_indicator_format">Langkah %1$d dari %2$d: %3$s</string>
    <string name="https_wizard_security_title">Keamanan &amp; Privasi</string>
    <string name="https_wizard_security_desc">Sertifikat Root CA dibuat secara lokal di perangkat Anda dan tidak pernah meninggalkan ponsel Anda. BlockAds menggunakannya secara ketat untuk menghapus iklan di situs web. Layanan sensitif seperti aplikasi perbankan dan akun Google tidak pernah dicegat.</string>
    <string name="https_wizard_explain_title">Mengapa Pemfilteran HTTPS?</string>
    <string name="https_wizard_explain_desc">Sebagian besar situs web dan iklan modern menggunakan koneksi HTTPS terenkripsi. Untuk menyembunyikan placeholder iklan, banner, dan pop-up, BlockAds memerlukan sertifikat lokal untuk memeriksa dan memfilter halaman web dengan aman di perangkat Anda.</string>
    <string name="https_wizard_benefits_title">Manfaat Utama</string>
    <string name="https_wizard_benefit_1">Hilangkan iklan di platform video &amp; situs berita</string>
    <string name="https_wizard_benefit_2">Sembunyikan placeholder kosong, banner, dan pop-up yang mengganggu</string>
    <string name="https_wizard_benefit_3">Jalankan Scriptlet untuk mengalahkan mekanisme anti-adblock</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% di Perangkat</string>
    <string name="https_wizard_privacy_on_device_desc">Kunci dan sertifikat dibuat secara lokal di ponsel Anda dan tidak pernah dikirimkan ke mana pun.</string>
    <string name="https_wizard_privacy_bypass_title">Lewati Aplikasi Perbankan &amp; Keuangan</string>
    <string name="https_wizard_privacy_bypass_desc">Domain sensitif (bank, identifikasi, Google) diteruskan secara langsung dan tidak pernah didekripsi.</string>
    <string name="https_wizard_privacy_browser_title">Cakupan Browser Terkendali</string>
    <string name="https_wizard_privacy_browser_desc">Anda memiliki kendali penuh atas browser mana yang menggunakan pemfilteran HTTPS, dan dapat menonaktifkannya kapan saja.</string>
    <string name="https_wizard_cert_file_type">Sertifikat X.509 CA (.crt)</string>
    <string name="https_wizard_cert_status_exported">Disimpan ke Unduhan</string>
    <string name="https_wizard_cert_status_not_exported">Siap disimpan</string>
    <string name="https_wizard_cert_save_note">File sertifikat akan disimpan di folder Unduhan perangkat Anda. Anda akan menginstalnya di langkah berikutnya.</string>
    <string name="https_wizard_device_brand_format">Perangkat Target: %1$s</string>
    <string name="https_wizard_device_brand_generic">Perangkat Android Anda</string>
    <string name="https_wizard_install_instructions_title">Panduan Langkah demi Langkah</string>
    <string name="https_wizard_root_detected_title">Akses Root Terdeteksi (Disarankan)</string>
    <string name="https_wizard_root_detected_desc">Perangkat Anda memiliki akses root. Anda dapat menginstal sertifikat CA secara otomatis tanpa konfigurasi manual.</string>
    <string name="https_wizard_checking_title">Memverifikasi Sertifikat…</string>
    <string name="https_wizard_checking_desc">Memindai penyimpanan tepercaya Android untuk BlockAds CA…</string>
    <string name="https_wizard_installed_desc">BlockAds Root CA telah diverifikasi dan aktif di penyimpanan tepercaya perangkat Anda. Pemfilteran HTTPS tingkat lanjut siap digunakan!</string>
    <string name="https_wizard_not_installed_title">Sertifikat Tidak Terdeteksi</string>
    <string name="https_wizard_not_installed_desc">BlockAds belum menemukan sertifikat di penyimpanan tepercaya Anda. Jika Anda baru saja selesai menginstalnya di Pengaturan, ketuk di bawah untuk memeriksa lagi.</string>
    <string name="https_wizard_troubleshooting_title">Tips Pemecahan Masalah</string>
    <string name="https_wizard_troubleshooting_tip1">Pastikan Anda memilih \"Sertifikat CA\" di Pengaturan (bukan Sertifikat Pengguna atau Sertifikat Pengguna VPN &amp; aplikasi).</string>
    <string name="https_wizard_troubleshooting_tip2">Jika menginstal melalui modul Magisk/KernelSU, perangkat perlu dimulai ulang.</string>
    <string name="https_wizard_troubleshooting_tip3">Periksa apakah file sertifikat telah diunduh dengan benar ke folder Unduhan Anda.</string>
