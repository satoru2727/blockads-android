    <string name="https_wizard_benefit_2">הסתרת שומרי מקום ריקים, באנרים וחלונות קופצים פולשניים</string>
    <string name="https_wizard_benefit_3">הפעלת Scriptlets כדי לעקוף מנגנוני אנטי-חסימת מודעות</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% במכשיר</string>
    <string name="https_wizard_privacy_on_device_desc">המפתחות והתעודה נוצרים מקומית בטלפון שלך ולעולם אינם מועברים לשום מקום.</string>
