    <string name="https_wizard_security_title">אבטחה ופרטיות</string>
    <string name="https_wizard_security_desc">תעודת ה-Root CA נוצרת מקומית במכשיר שלך ולעולם אינה עוזבת את הטלפון שלך. BlockAds משתמשת בה אך ורק כדי להסיר מודעות באתרי אינטרנט. שירותים רגישים כגון אפליקציות בנקאיות וחשבונות Google אינם מיורטים לעולם.</string>
    <string name="https_wizard_explain_title">למה סינון HTTPS?</string>
    <string name="https_wizard_explain_desc">רוב האתרים והמודעות המודרניים משתמשים בחיבורי HTTPS מוצפנים. כדי להסתיר שומרי מקום של מודעות, באנרים וחלונות קופצים, BlockAds דורשת תעודה מקומית כדי לבדוק ולסנן דפי אינטרנט בבטחה במכשיר שלך.</string>
    <string name="https_wizard_benefits_title">יתרונות מרכזיים</string>
